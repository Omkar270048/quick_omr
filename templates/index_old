{% extends "base.html" %}

{% block title %}Upload Images{% endblock %}

{% block content %}
    <div class="container">
        <div class="marquee">
            <marquee>OMR CHECK ANSWER</marquee>
        </div>
        <button style="float: right;" hidden>
            <a href="{{ url_for('answer_key') }}" class="button-link">Add Answer Key</a>
        </button>

        <h1>Upload OMR</h1>
        <form action="/" method="post" enctype="multipart/form-data">
            <input type="text" name="examid" class="form-control" placeholder="Exam ID" required><br>
            <input type="date" name="exam_date"  class="form-control" required><br><br>
            <input type="file" name="files" accept="image/*" multiple required>
            <input type="submit" value="Upload">
        </form>
        
        <img id="imagePreview" class="image-preview" src="" alt="Image Preview" style="display: none;">
        <div id="imageInfo" class="image-info"></div>
    </div>
{% endblock %} 